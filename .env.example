# ============================================
# Cloud-Based Student Assignment Submission & Feedback Portal
# Environment variables -- copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file. It is already excluded via .gitignore.
# ============================================

# --- Flask ---
FLASK_DEBUG=true
PORT=5000

# --- Secrets (generate strong random values for real deployments) ---
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_EXPIRES_HOURS=8

# --- Database ---
# Local/free-tier default: SQLite file.
# Cloud options: postgresql://user:pass@host:5432/dbname  (Supabase/RDS)
#                or a Firestore/DynamoDB connection via a different service layer.
DATABASE_URL=sqlite:///portal.db

# --- Object Storage ---
# "local" for free/local development. Swap to "s3" in production
# and add AWS_* / FIREBASE_* credentials as needed.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./backend/storage/assignments

# --- Upload validation ---
ALLOWED_EXTENSIONS=pdf,doc,docx,zip,png,jpg,jpeg
MAX_FILE_SIZE_MB=10

# --- CORS ---
CORS_ORIGINS=*

# --- Business rules ---
ALLOW_LATE_SUBMISSION=true
ALLOW_RESUBMISSION=true

# --- Future cloud-provider credentials (left blank on purpose) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
